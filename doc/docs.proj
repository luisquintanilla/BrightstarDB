<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003"
         DefaultTargets="Build">

  <Target Name="Html">
    <Exec Command="make.bat html" WorkingDirectory="src" />
  </Target>

  <!-- API documentation: The legacy Sandcastle/CHM toolchain (api/BrightstarDB.shfbproj)
       is no longer functional with the .NET 10 build. Consider using docfx for API docs:
       https://dotnet.github.io/docfx/ -->
  <Target Name="Build" DependsOnTargets="Html"/>

</Project>
