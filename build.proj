<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
        <PackageVersion Condition=" '$(PackageVersion)' == '' ">2.0.0</PackageVersion>
    </PropertyGroup>

    <!-- Main Build Targets -->
    <Target Name="Build" DependsOnTargets="CompileCore" />

    <Target Name="Clean" DependsOnTargets="CleanCore">
        <RemoveDir Directories="build" />
    </Target>

    <Target Name="NuGet" DependsOnTargets="PackBrightstarDBLibs;PackBrightstarDBCodegen;PackBrightstarDBBundle" />

    <Target Name="Test" DependsOnTargets="CompileCore">
        <Exec Command="dotnet test src\core\core.sln -c:$(Configuration) --no-build --nologo" />
    </Target>

    <!-- Sub-targets -->
    <Target Name="CompileCore">
        <MSBuild Projects="src\core\core.sln"
                 Properties="Configuration=$(Configuration)"
                 Targets="Restore;Build" />
    </Target>

    <Target Name="CleanCore">
        <MSBuild Projects="src\core\core.sln"
                 Properties="Configuration=$(Configuration)"
                 Targets="Clean" />
    </Target>

    <!-- NuGet Pack Targets -->
    <Target Name="PackBrightstarDBLibs">
        <Exec Command="dotnet pack src\core\BrightstarDB.Core\BrightstarDB.Core.csproj -c:$(Configuration) -p:PackageVersion=$(PackageVersion)" />
    </Target>

    <Target Name="PackBrightstarDBCodegen">
        <Exec Command="dotnet pack src\core\BrightstarDB.CodeGeneration\BrightstarDB.CodeGeneration.csproj -c:$(Configuration) -p:PackageVersion=$(PackageVersion)" />
        <Exec Command="dotnet pack src\core\BrightstarDB.CodeGeneration.Console\BrightstarDB.CodeGeneration.Console.csproj -c:$(Configuration) -p:PackageVersion=$(PackageVersion)" />
        <Exec Command="dotnet pack src\core\BrightstarDB.CodeGeneration.T4\BrightstarDB.CodeGeneration.T4.csproj -c:$(Configuration) -p:PackageVersion=$(PackageVersion)" />
    </Target>

    <Target Name="PackBrightstarDBBundle">
        <Exec Command="dotnet pack src\core\BrightstarDB\BrightstarDB.csproj -c:$(Configuration) -p:PackageVersion=$(PackageVersion)" />
    </Target>
</Project>
